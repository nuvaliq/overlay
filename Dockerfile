# Overlay image of OnlyOffice Document Server: the official image + static files
# built from the fork sources (web-apps, sdkjs, sdkjs-forms).
#
# The binary parts (x2t/core, server, fonts, dictionaries) are taken from the base image as
# is: only the JavaScript static files are rebuilt; the brotli_static module from the Ubuntu package
# is added to the base's nginx (the compression step below). The base image has no plugins, only the
# "Plugin Manager"; the image disables their loading at startup (ENV PLUGINS_ENABLED below).
# The build context is prepared by overlay/prepare.sh and the build is run by overlay/build.sh.
#
# There are no pins here at all: the base image arrives as an argument from versions.env.
# BASE_IMAGE intentionally has no default value: a direct build without the argument must
# fail right away rather than silently take a stale base.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# Overlay on top of the existing directories: the contents of the base image are NOT deleted.
# This keeps in place the files that are not in the JS build, such as sdkjs/*/sdk-all.bin
# (the x2t engine js cache), while sdkjs-plugins, fonts,
# core-fonts, dictionaries, server, npm, document-formats, document-templates stay untouched alongside.
# The owner and modes (directories 0555, files 0444) are set in the context
# by prepare.sh and preserved by COPY.
COPY --chown=ds:ds context/sdkjs/    /var/www/onlyoffice/documentserver/sdkjs/
COPY --chown=ds:ds context/web-apps/ /var/www/onlyoffice/documentserver/web-apps/

# Remove the pre-compressed copies under the overlaid trees: at container start
# documentserver-static-gzip.sh recompresses the static files from scratch (gzip -kf9), but until
# then nginx with gzip_static on would serve the .gz of the old static files.
# The 9.4.0.1 base image has no such files (the gz are created only at startup);
# the command is a safeguard in case of a different base image.
# The failure is not suppressed: deleting a file requires write permission on its directory, and the directories from the
# context have mode 0555, so under an unprivileged user (rootless docker,
# a base with a set USER) the deletion would return "Permission denied". This must not be suppressed, or the
# .gz files of the base image would remain in the image while the build passed green, that is, the step
# would do nothing in exactly the case it was introduced for. The absence of files is not
# a failure by construction: find -delete with no matches exits with zero.
RUN find /var/www/onlyoffice/documentserver/sdkjs \
         /var/www/onlyoffice/documentserver/web-apps \
         -name '*.gz' -type f -delete

# Pre-compressed brotli copies of the static files. For a client with br in Accept-Encoding, nginx
# serves <file>.br, and the rest get .gz as before: brotli -q 11 on these static files is noticeably smaller than
# gzip -9 (sdk-all-min.js is smaller by a quarter), and a cold open of the editor transfers less.
#
# nginx serves .br without checking it against the source file, while the image scripts recreate
# only .gz at startup. Therefore .br is made only for files that do not change after the build: the same
# selection by which the image's documentserver-static-gzip.sh compresses files into .gz, but only in sdkjs, web-apps
# and dictionaries and without the files written by startup: AllFonts.js, sdkjs/common/Images (font
# and theme previews), sdkjs/slide/themes, the x2t js cache sdk-all.bin, and api.js (the image script renders it from
# api.js.tpl on every call of the version wrapper below). sdkjs-plugins is not included:
# with PLUGINS_ENABLED=true the plugin manager rewrites the directory; fonts is not either, since the fonts are
# generated by startup. The base image has no .br; a base that has them stops the step:
# their composition would have to be verified anew.
#
# The module is the Ubuntu package libnginx-mod-http-brotli-static from the base image's release. The package
# depends on nginx-abi-<version> of the nginx binary, so apt installs only the build compatible with it,
# and the last command of the step loads the module into this nginx. The brotli utility is needed only
# for compression and is removed by the same step; its version is the version of the already installed libbrotli1, otherwise apt
# would update the base image's library. The set of packages after the step is compared with the original:
# only the module is added, nothing is updated or removed. The apt lists and cache live in the
# step's temporary file system and do not end up in the image. An unavailable apt source stops
# the step: by default apt-get update treats a network failure of a source as a warning, and with
# security.ubuntu.com unavailable the step would install packages without seeing security updates.
#
# The brotli_static directive goes on a separate line after gzip_static in the three static locations of
# ds-docservice.conf: the service worker, *.json from web-apps, and the common location of web-apps, sdkjs,
# dictionaries, and other static directories. Startup enables gzip_static by replacing the line through to its
# end (sed in documentserver-static-gzip.sh) and would wipe out a directive standing on the same line.
# The api.js location does not have it.
RUN --mount=type=tmpfs,target=/var/lib/apt/lists \
    --mount=type=tmpfs,target=/var/cache/apt \
    --mount=type=tmpfs,target=/tmp \
    set -eu; \
    cd /var/www/onlyoffice/documentserver; \
    test -z "$(find sdkjs web-apps sdkjs-plugins fonts dictionaries -name '*.br' -print -quit)"; \
    dpkg-query -W -f='${Package}=${Version}\n' | sort > /tmp/packages.before; \
    apt-get -o APT::Update::Error-Mode=any update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        libnginx-mod-http-brotli-static "brotli=$(dpkg-query -W -f='${Version}' libbrotli1)"; \
    find sdkjs web-apps dictionaries -type f \
        \( -name '*.js' -o -name '*.json' -o -name '*.htm' -o -name '*.html' \
           -o -name '*.css' -o -name '*.bin' -o -name '*.wasm' -o -name '*.dic' \
           -o -name '*.aff' -o -name '*.svg' \) \
        ! -name sdk-all.bin ! -path sdkjs/common/AllFonts.js ! -path 'sdkjs/common/Images/*' \
        ! -path 'sdkjs/slide/themes/*' ! -path web-apps/apps/api/documents/api.js \
        -print0 > /tmp/brotli.list; \
    xargs -0 -r -P "$(nproc)" -n 64 brotli -q 11 -- < /tmp/brotli.list; \
    DEBIAN_FRONTEND=noninteractive apt-get purge -y brotli; \
    dpkg-query -W -f='${Package}=${Version}\n' | sort > /tmp/packages.after; \
    test -z "$(comm -23 /tmp/packages.before /tmp/packages.after)"; \
    test "$(comm -13 /tmp/packages.before /tmp/packages.after | cut -d= -f1)" \
        = libnginx-mod-http-brotli-static; \
    conf=/etc/onlyoffice/documentserver/nginx/includes/ds-docservice.conf; \
    sed -i \
        -e '/(document_editor_service_worker/,/^}/{/gzip_static/a\  brotli_static on;' -e '}' \
        -e '/(web-apps)(/,/^}/{/gzip_static/a\  brotli_static on;' -e '}' \
        -e '/(web-apps|sdkjs|/,/^}/{/gzip_static/a\  brotli_static on;' -e '}' \
        "$conf"; \
    test "$(grep -c '^  brotli_static on;$' "$conf")" = 3; \
    printf '%s\n' 'include /etc/nginx/modules-enabled/*.conf;' 'events {}' \
        'http { server { location / { brotli_static on; } } }' > /tmp/nginx-brotli.conf; \
    nginx -q -t -c /tmp/nginx-brotli.conf

# Static version by content instead of start time: a wrapper over the image's
# documentserver-flush-cache.sh (why and how is in the wrapper itself). /usr/local/bin
# comes earlier in PATH than /usr/bin, so startup and font regeneration call the wrapper,
# while the image script stays untouched. Mode 0755 is set here rather than taken from the working
# copy: without the execute bit the shell silently skips the wrapper and calls the image script.
COPY --chmod=0755 documentserver-flush-cache.sh /usr/local/bin/documentserver-flush-cache.sh

# Plugin loading at startup is disabled. The base image's startup script, with
# PLUGINS_ENABLED=true (its default), downloads in the background the latest plugin release from the list
# sdkjs-plugins/plugin-list-default.json at onlyoffice.github.io, without pinning a version.
# This image has no such download, and there are no plugins on the node. To turn it back on, set
# PLUGINS_ENABLED=true in the container environment: it overrides the image ENV. The "Plugin Manager"
# (sdkjs-plugins/marketplace) remains from the base image, and which plugins are shown in the editor
# is set by the integrator with the customization.plugins parameter.
ENV PLUGINS_ENABLED=false

# Metadata goes last: changing the tag or revision must not invalidate the cache of the two overlay
# layers of 953 MB. ARG after FROM is declared anew, otherwise the value in LABEL is not
# substituted.
ARG BASE_IMAGE
# The base digest as a separate label: otherwise it would have to be picked out of the reference by eye, and when building
# with a BASE_IMAGE without a digest the label will honestly say unknown. The value is supplied by build.sh.
ARG BASE_DIGEST=unknown
ARG IMAGE_VERSION=unknown
ARG IMAGE_REF=unknown
ARG OVERLAY_REVISION=unknown
ARG CREATED=unknown
# Context provenance: the values come from the readiness stamp (context/.overlay-stamp),
# which prepare.sh writes. It shows what code the static files in the image were built from.
ARG SOURCE_TAG=unknown
ARG WEB_APPS_REV=unknown
ARG SDKJS_REV=unknown
ARG SDKJS_FORMS_REV=unknown
ARG BUILD_TOOLS_REV=unknown
ARG API_TPL_SHA256=unknown
ARG SDK_MINIFY=unknown
ARG SDK_MINIFY_TERSER=unknown

LABEL org.opencontainers.image.base.name="${BASE_IMAGE}" \
      org.opencontainers.image.base.digest="${BASE_DIGEST}" \
      org.opencontainers.image.version="${IMAGE_VERSION}" \
      org.opencontainers.image.ref.name="${IMAGE_REF}" \
      org.opencontainers.image.revision="${OVERLAY_REVISION}" \
      org.opencontainers.image.created="${CREATED}" \
      org.opencontainers.image.licenses="AGPL-3.0-only" \
      org.opencontainers.image.title="Document Server overlay" \
      org.opencontainers.image.description="onlyoffice/documentserver с пересобранной из исходников форка JS-статикой (web-apps, sdkjs)" \
      overlay.source-tag="${SOURCE_TAG}" \
      overlay.web-apps.revision="${WEB_APPS_REV}" \
      overlay.sdkjs.revision="${SDKJS_REV}" \
      overlay.sdkjs-forms.revision="${SDKJS_FORMS_REV}" \
      overlay.build-tools.revision="${BUILD_TOOLS_REV}" \
      overlay.api-tpl.sha256="${API_TPL_SHA256}" \
      overlay.sdk-minify.mode="${SDK_MINIFY}" \
      overlay.sdk-minify.terser="${SDK_MINIFY_TERSER}"
