# Pins of the overlay image build: the only place in the repository where the
# base image, versions, revisions, and addresses are set. Read by prepare.sh, build.sh, build-static.sh, and
# the pipeline; repeating any value in a second file is considered a defect.
#
# Format: KEY=value, one pair per line, no quotes and no spaces around the equals
# sign. The value is taken verbatim: the file is not executed, so substitutions such as
# $(...) and ${...} would stay in the value as is. Comments start with #.
# An empty value (KEY= with nothing after it) is allowed and means "default"; this is how
# NPM_REGISTRY is set. Parsing is read_key_value_file in lib.sh, the set of keys is defined there too.
#
# The file is the only source of pins. An environment variable named like a key does not
# change the value: otherwise whoever launches the build would choose the images whose code runs on the build machine and
# the place the built image is sent to. A deliberate deviation is an explicit script argument; this is
# also how a build that takes images from a mirror and pushes the result to its
# own registry supplies its addresses:
#   bash build.sh --override BASE_IMAGE=<mirror>/onlyoffice/documentserver:9.4.0.1@sha256:...
#
# Image addresses (BASE_IMAGE, IMAGE_REPO, NODE_IMAGE) must lead to the registry allowed for their
# key: the table is the constant REGISTRY_ALLOWED_BY_KEY in lib.sh (BASE_IMAGE and NODE_IMAGE
# are Docker Hub, IMAGE_REPO is localhost), and the values of this file are always checked against it, before
# the first call to docker.

# Base image. Pinned by digest, not only by tag: a tag in the registry is mutable, and under
# it a different binary part may one day arrive. We rebuild the static files, but take x2t/core, server,
# fonts, and dictionaries from the base as they are (the base has no plugins, and the image
# disables loading them at startup; see the Dockerfile). A digest identifies the manifest, and
# the content under it cannot be replaced. Docker accepts the form repo:tag@sha256:...:
# resolution goes by the digest, and the tag stays readable in the labels and in the build log.
# The address is Docker Hub. Moving to a new base is a deliberate rewrite of this line using
# the actual value of the new image
# (docker image inspect <image> --format '{{index .RepoDigests 0}}').
BASE_IMAGE=onlyoffice/documentserver:9.4.0.1@sha256:3ab6ebc7c605e5a32b7ae3ff19daed4925090245acc8100ce2230bd766c88212

# Version of the base image: the prefix of the built image's tag. It is not derived from PRODUCT_VERSION and
# BUILD_NUMBER: 9.4.0.1 is the Document Server build version, while 9.4.0/129 is the version
# and build number of the static files. The default local build is IMAGE_TAG_BASE-local.
IMAGE_TAG_BASE=9.4.0.1

# The tag the source clones must be on: the context is built from their deploy/.
# It is checked against the list of tags on HEAD, not through git describe: these commits carry
# several tags, and describe returns the wrong one.
# A release tag looks like v<PRODUCT_VERSION>.<BUILD_NUMBER>-b24.N, where N is the release number, one
# for everything: the number in the "About" window (the tag without the leading v) = the overlay tag = the SOURCE_TAG of the forks,
# and the release image is <IMAGE_TAG_BASE>-b24.N (README, section on the v9.4.0.129 tag).
SOURCE_TAG=v9.4.0.129-b24.16

# The source URL that the "About" window names next to the release number: the page of the
# release tag in the public overlay repository, ending in /<SOURCE_TAG>. Changed in the release MR
# together with SOURCE_TAG. A copy of overlay without its own public repository may put a placeholder
# of the .invalid domain here: a local build passes an empty address instead of it, and a release build
# is given the real address by the --override argument.
# A release build (--release) checks the address before starting docker (check_release_inputs in lib.sh).
SOURCE_URL=https://github.com/nuvaliq/overlay/tree/v9.4.0.129-b24.16

# The build_tools revision. Pinned because the python code of this clone is executed while
# preparing the context (make.py imports base.py from there) and the result lands in api.js,
# the entry point of the whole client side. build_tools has no tags corresponding to release 9.4.0.129,
# and master moves, so the pin is by full SHA.
BUILD_TOOLS_REV=a9f9895b172b09595abcafe85d56fab163f9ecb7

# Version and build number of the static files. Substituted into the api.js cache version (?_dc=9.4.0-129) and into
# the sdkjs/web-apps build, so the format is checked before substitution: a '/' character in the value
# would end the sed expression early.
PRODUCT_VERSION=9.4.0
BUILD_NUMBER=129

# Minification of the six SDKs; to disable, use --override SDK_MINIFY=0.
# Terser is taken from web-apps/build/node_modules and must exactly match the pin.
SDK_MINIFY=1
TERSER_VERSION=5.28.1

# Expected SHA-256 of the finished api.js.tpl after the embed worker is inlined and the version substituted.
# Empty means a mandatory check against the reference from the base image. For a modified API, the exactly
# verified result is pinned here and updated together with the source changes.
# This pin does not cancel the check of the source tag or the build_tools revision.
EXPECTED_API_TPL_SHA256=30a260572ddb60ce720497c2514ee3eabc7b9aa8a48e86b84f2c566d20f7e773

# Repository of the built image. By default only a local name: docker will not pull localhost/... from
# Docker Hub, so without a built image docker run cannot substitute somebody else's image for it.
# To push to your own registry, use the override --override IMAGE_REPO=<registry>/<path>.
IMAGE_REPO=localhost/documentserver-overlay

# Node image for building the static files. An empty value means "build with the host's tools",
# a path for a machine where Node is already installed.
NODE_IMAGE=node:24

# npm registry for building the static files. Empty means the default registry of the Node image; a non-empty
# value is passed into the build container as npm_config_registry.
NPM_REGISTRY=

# Source addresses. The build does not read them: the scripts take ready-made clone directories
# (WEBAPPS_DIR, SDKJS_DIR, SDKJS_FORMS_DIR, BUILD_TOOLS_DIR), and a person clones them following the
# README (section on sources). The keys live here, next to SOURCE_TAG and BUILD_TOOLS_REV, so that the
# address and the pinned revision do not drift apart. The addresses of the public repositories of the
# forks are recorded here.
BUILD_TOOLS_URL=https://github.com/ONLYOFFICE/build_tools
WEB_APPS_URL=https://github.com/nuvaliq/web-apps.git
SDKJS_URL=https://github.com/nuvaliq/sdkjs.git
SDKJS_FORMS_URL=https://github.com/nuvaliq/sdkjs-forms.git
